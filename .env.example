# ---------- REQUIRED for Day 1 / Day 5 (PayPal sandbox) ----------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox PERSONAL account email that plays the vendor (receives payouts)
VENDOR_EMAIL=

# ---------- REQUIRED for Day 4 (mandate parser): Groq, free ----------
# console.groq.com > API Keys (key starts with gsk_)
GROQ_API_KEY=
# Optional. Default is openai/gpt-oss-120b. Run `npm run llm:ping` to list the models your key can use.
GROQ_MODEL=

# ---------- REQUIRED for Day 6 (real webhooks) ----------
# From developer.paypal.com > your app > Webhooks > the webhook you created
PAYPAL_WEBHOOK_ID=

# ---------- Optional ----------
PORT=3000
# If set, every /api/* request must send header x-api-key: <value>
ADMIN_API_KEY=
# Code-level ceiling the LLM-parsed mandate can never exceed (default 5000)
HARD_MAX_WEEKLY_USD=5000

CHANNEL3_API_KEY=
