# ---------- REQUIRED for Day 1 / Day 5 (PayPal sandbox) ----------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox PERSONAL account email that plays the vendor (receives payouts)
VENDOR_EMAIL=

# ---------- REQUIRED for Day 4 (mandate parser): Groq, free ----------
# console.groq.com > API Keys (key starts with gsk_)
GROQ_API_KEY=
# Optional. Default is openai/gpt-oss-120b. Run `npm run llm:ping` to list the models your key can use.
GROQ_MODEL=

# ---------- REQUIRED for Day 6 (real webhooks) ----------
# From developer.paypal.com > your app > Webhooks > the webhook you created
PAYPAL_WEBHOOK_ID=

CHANNEL3_API_KEY=

# ---------- Optional ----------
PORT=3000
# If set, every /api/* request must send header x-api-key: <value>
ADMIN_API_KEY=
# Code-level ceiling the LLM-parsed mandate can never exceed (default 5000)
HARD_MAX_WEEKLY_USD=5000
# How often (seconds) the server asks PayPal about payments still in flight. 0 = off.
RECONCILE_SECONDS=10

# ---------- Public demo (set these on the hosted version; leave off locally) ----------
DEMO_MODE=false
# Purchases per hour: all visitors together, and per visitor address. 0 = no limit.
LIMIT_PURCHASES_PER_HOUR=10
LIMIT_PURCHASES_PER_IP_PER_HOUR=4
# AI rule-readings per hour (all visitors / per address)
LIMIT_PARSES_PER_HOUR=60
LIMIT_PARSES_PER_IP_PER_HOUR=15
# How long an idle visitor's demo data is kept, and the most visitors kept at once
SESSION_TTL_MINUTES=120
MAX_SESSIONS=300


