{
  "name": "autopilot-cfo",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
  "concurrently": "^9.0.1"
  },
  "scripts": {
    "test": "npm -w packages/guardrail run test && npm -w apps/server run test && npm -w apps/web run test",
    "typecheck": "npm -w packages/guardrail run typecheck && npm -w apps/server run typecheck && npm -w apps/web run typecheck",
    "start": "npm -w apps/server run start",
    "dev:web": "npm -w apps/web run dev",
    "build:web": "npm -w apps/web run build",
    "dev:all": "concurrently -n server,web -c blue,green \"npm:dev\" \"npm:dev:web\"",
    "dev": "npm -w apps/server run dev",
    "paypal:token": "npm -w apps/server run paypal:token",
    "paypal:order": "npm -w apps/server run paypal:order",
    "paypal:capture": "npm -w apps/server run paypal:capture --",
    "paypal:payout": "npm -w apps/server run paypal:payout --",
    "mandate:parse": "npm -w apps/server run mandate:parse --",
    "llm:ping": "npm -w apps/server run llm:ping",
    "demo:slice": "npm -w apps/server run demo:slice --",
    "seller:demo": "npm -w apps/server run seller:demo --",
    "negotiate:demo": "npm -w apps/server run negotiate:demo --",
    "buyer:demo": "npm -w apps/server run buyer:demo --",
    "channel3:search": "npm -w apps/server run channel3:search --",
    "pipeline:demo": "npm -w apps/server run pipeline:demo --",
    "demo:video": "npm -w apps/server run demo:video --",
    "payout:cancel-demo": "npm -w apps/server run payout:cancel-demo",
    "webhook:admin": "npm -w apps/server run webhook:admin --",
    "webhook:forged": "npm -w apps/server run webhook:forged"
  },
  "engines": { "node": ">=20" }
}
